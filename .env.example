# ─── Sync from the HiddenGem AI platform ──────────────────────────────────────
# Used by the automatic sync (scripts/sync-all.mts, runs on predev/prebuild).
# Copy this file to .env.local and fill in the values.

# Base URL of the HiddenGem AI platform deployment (no trailing slash).
HG_PLATFORM_URL=https://hiddengem-ai.netlify.app

# Agency-wide CRON secret from the platform. The platform's middleware maps
# `Authorization: Bearer <this>` onto a trusted dashboard session, unlocking the
# read endpoints this dashboard pulls from (/clients, /admin/roi-export, /contacts).
# SERVER-ONLY — never expose to the browser, never prefix with NEXT_PUBLIC_.
# Put the real value in .env.local (gitignored), NOT here.
HG_CRON_SECRET=

# ─── Netlify only (production scheduled rebuild) ──────────────────────────────
# Build-hook URL that the scheduled function (netlify/functions/scheduled-rebuild.mts)
# POSTs every 4h to trigger a fresh deploy. Set this in the Netlify site's env,
# not here — it's only read at runtime by the Netlify function.
# BUILD_HOOK_URL=https://api.netlify.com/build_hooks/xxxxxxxxxxxxxxxx

# ─── Sync from Google Drive (existing pipeline) ───────────────────────────────
# Only needed if you also use the "Sync Month" (Google Drive) panel.
# DRIVE_ROOT_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_PATH=service-account.json