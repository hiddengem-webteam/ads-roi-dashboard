# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files (contain client PII — do not commit).
# Everything under public/data is generated by the sync (incl. manifest.json,
# which lists the client roster) and regenerated on every predev/prebuild.
/data/
/public/data/*
# Exception: the frozen July 2026 snapshot is an intentional one-off — deploying
# /july needs it on Netlify since the snapshot/merge scripts aren't part of the
# predev/prebuild pipeline. Still real guest PII; committed by explicit decision.
!/public/data/snapshots/
/public/data/snapshots/*
!/public/data/snapshots/july-2026.json

# Raw account-manager PMS exports (real guest PII) — never commit.
/July 2026 PMS Data/

# Google service account credentials
service-account.json

# GHL per-client API credentials (real production secrets — never commit)
GHL API keys.sql
ghl-credentials.local.json

# Transient QA report from scripts/convert-july-xlsx.mts — regenerable, not source
scripts/.july-xlsx-conversion-report.json

# local env overrides
.env.local

# Local Netlify folder
.netlify

# Sentinel tool artifacts
/sentinel-ultra/
